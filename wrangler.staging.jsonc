{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxlanding-migration-platform-staging",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
