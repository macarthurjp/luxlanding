{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxlanding-www-redirect",
  "main": "workers/www-redirect.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "www.luxlanding.eu",
      "custom_domain": true
    }
  ]
}
